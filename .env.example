DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.gov.ph
DATABASE_URL=postgresql://sdo_sulu:change-me@127.0.0.1:5432/sdo_sulu
DJANGO_SECURE_SSL_REDIRECT=False
# Keep public request, appointment, and help-desk submission routes disabled.
ENABLE_ONLINE_TRANSACTIONS=False
# Staff accounts should be created by an administrator.
ENABLE_PUBLIC_REGISTRATION=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.gov.ph
EMAIL_PORT=587
EMAIL_HOST_USER=portal@example.gov.ph
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="SDO Sulu Portal <portal@example.gov.ph>"
ADMIN_EMAILS=administrator@example.gov.ph
LOG_LEVEL=INFO
# Official SDO Sulu Facebook Page sync. Keep the access token secret.
FACEBOOK_PAGE_ID=100042494841401
FACEBOOK_PAGE_URL=https://www.facebook.com/profile.php?id=100042494841401
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v23.0
# Optional existing portal username recorded as the imported news author.
FACEBOOK_SYNC_AUTHOR=
