[Unit]
Description=Expire scheduled SDO Sulu publications
After=postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/srv/sdo-sulu
EnvironmentFile=/srv/sdo-sulu/.env
ExecStart=/srv/sdo-sulu/.venv/bin/python manage.py expire_publications
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sdo-sulu/media
